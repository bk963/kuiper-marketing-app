# === Auth ===
ADMIN_JWT_SECRET=                 # >=32 chars random

# === Marketing PocketBase (eigene Instanz) ===
MPB_URL=https://mpb.kuiper-safety.de
PB_CF_ACCESS_CLIENT_ID=
